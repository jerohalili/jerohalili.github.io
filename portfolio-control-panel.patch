diff --git a/src/styles/themes.css b/src/styles/themes.css
new file mode 100644
index 0000000..0846535
--- /dev/null
+++ b/src/styles/themes.css
@@ -0,0 +1,44 @@
+/* ==========================================================================
+   Design tokens + themes
+   --------------------------------------------------------------------------
+   Everything here is driven by attributes on <html>, set by the appearance
+   script in Layout.astro (window.__appearance):
+
+     data-theme="clean | command | terminal"
+     data-accent="orange | rose | violet | blue | cyan | emerald"
+     data-fx-*="on | off"      (motion, particles, tilt, magnetic, glow, scanlines)
+
+   The default state (clean + orange + everything on) is visually identical
+   to the site before the Control Panel existed.
+   ========================================================================== */
+
+/* ---- Base palette (Tailwind's zinc scale, as channels) ---- */
+:root {
+  --zinc-50: 250 250 250;
+  --zinc-100: 244 244 245;
+  --zinc-200: 228 228 231;
+  --zinc-300: 212 212 216;
+  --zinc-400: 161 161 170;
+  --zinc-500: 113 113 122;
+  --zinc-600: 82 82 91;
+  --zinc-700: 63 63 70;
+  --zinc-800: 39 39 42;
+  --zinc-900: 24 24 27;
+  --zinc-950: 9 9 11;
+
+  /* Accent defaults to orange so first paint is correct even before JS. */
+  --accent-50: 255 247 237;
+  --accent-400: 251 146 60;
+  --accent-500: 249 115 22;
+  --accent-600: 234 88 12;
+}
+
+/* ---- Accent palettes ----
+   cyan and emerald use a deeper 500 so white text on accent buttons stays
+   readable; 400 stays bright for text on dark backgrounds. */
+html[data-accent='orange'] { --accent-50: 255 247 237; --accent-400: 251 146 60;  --accent-500: 249 115 22;  --accent-600: 234 88 12; }
+html[data-accent='rose']   { --accent-50: 255 241 242; --accent-400: 251 113 133; --accent-500: 244 63 94;   --accent-600: 225 29 72; }
+html[data-accent='violet'] { --accent-50: 245 243 255; --accent-400: 167 139 250; --accent-500: 139 92 246;  --accent-600: 124 58 237; }
+html[data-accent='blue']   { --accent-50: 239 246 255; --accent-400: 96 165 250;  --accent-500: 59 130 246;  --accent-600: 37 99 235; }
+html[data-accent='cyan']   { --accent-50: 236 254 255; --accent-400: 34 211 238;  --accent-500: 8 145 178;   --accent-600: 14 116 144; }
+html[data-accent='emerald']{ --accent-50: 236 253 245; --accent-400: 52 211 153;  --accent-500: 5 150 105;   --accent-600: 4 120 87; }
