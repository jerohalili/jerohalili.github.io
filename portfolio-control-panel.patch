+<script>
+  import { apply as setPerf, isLite } from '../scripts/lite';
+
+  type Origin = { x: number; y: number };
+  const api = () => (window as any).__appearance;
+  const $$ = <T extends HTMLElement = HTMLElement>(sel: string) =>
+    Array.from(document.querySelectorAll<T>(sel));
+
+  function seen(): boolean {
+    try { return localStorage.getItem('ui-seen') === '1'; } catch { return true; }
+  }
+
+  function paint() {
+    const a = api();
+    if (!a) return;
+    const s = a.state();
+
+    $$('[data-cp-theme]').forEach((el) =>
+      el.setAttribute('aria-checked', String(el.dataset.cpTheme === s.theme)));
+
+    $$('[data-cp-accent]').forEach((el) => {
+      if (el.dataset.cpAccent === 'auto') el.setAttribute('aria-pressed', String(!s.userAccent));
+      else el.setAttribute('aria-checked', String(el.dataset.cpAccent === s.accent));
+    });
+
+    const modeLocked = s.theme !== 'clean';
+    $$<HTMLButtonElement>('[data-cp-mode]').forEach((el) => {
+      el.setAttribute('aria-checked', String(el.dataset.cpMode === s.mode));
+      el.disabled = modeLocked;
+    });
+    $$('[data-cp-mode-note]').forEach((el) => { el.hidden = !modeLocked; });
+
+    $$('[data-cp-fx]').forEach((el) =>
+      el.setAttribute('aria-checked', String(!!s.fx[el.dataset.cpFx as string])));
+
+    const perf = isLite() ? 'lite' : 'full';
+    $$('[data-cp-perf]').forEach((el) =>
+      el.setAttribute('aria-checked', String(el.dataset.cpPerf === perf)));
+
+    // Roving tabindex so each radio group is a single tab stop (arrow keys move within).
+    $$('[role="radiogroup"]').forEach((group) => {
+      const radios = Array.from(group.querySelectorAll<HTMLElement>('[role="radio"]'));
+      const active = radios.find((r) => r.getAttribute('aria-checked') === 'true') ?? radios[0];
+      radios.forEach((r) => { r.tabIndex = r === active ? 0 : -1; });
+    });
+
+    const hide = seen();
+    $$('[data-cp-ping]').forEach((el) => { el.hidden = hide; });
+  }
+
+  function originOf(e: MouseEvent, el: HTMLElement): Origin {
+    // Keyboard activation reports 0,0, so fall back to the control's own center.
+    if (e.detail === 0 && e.clientX === 0 && e.clientY === 0) {
+      const r = el.getBoundingClientRect();
+      return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
+    }
+    return { x: e.clientX, y: e.clientY };
+  }
+
+  function dialog(): HTMLDialogElement | null {
+    return document.getElementById('control-panel') as HTMLDialogElement | null;
+  }
+
+  function onClick(e: MouseEvent) {
+    const dlg = dialog();
+    const target = e.target as HTMLElement | null;
+    if (!target) return;
+
+    // Click on the backdrop (the dialog element itself) closes the panel.
+    if (dlg && target === dlg) { dlg.close(); return; }
+
+    const el = target.closest<HTMLElement>(
+      '[data-cp-open],[data-cp-close],[data-cp-theme],[data-cp-accent],[data-cp-mode],[data-cp-fx],[data-cp-perf],[data-cp-reset]'
+    );
+    const a = api();
+    if (!el || !a) return;
+    const d = el.dataset;
+    const origin = originOf(e, el);
+
+    if (d.cpOpen !== undefined) {
+      try { localStorage.setItem('ui-seen', '1'); } catch { /* ignore */ }
+      if (dlg && !dlg.open) dlg.showModal();
+      paint();
+    } else if (d.cpClose !== undefined) {
+      dlg?.close();
+    } else if (d.cpTheme) {
+      a.setTheme(d.cpTheme, origin);
+    } else if (d.cpAccent) {
+      a.setAccent(d.cpAccent === 'auto' ? null : d.cpAccent, origin);
+    } else if (d.cpMode) {
+      if (!(el as HTMLButtonElement).disabled) a.setMode(d.cpMode, origin);
+    } else if (d.cpFx) {
+      a.setFx(d.cpFx, el.getAttribute('aria-checked') !== 'true');
+    } else if (d.cpPerf) {
+      setPerf(d.cpPerf as 'full' | 'lite');
+      paint();
+    } else if (d.cpReset !== undefined) {
+      a.reset(origin);
+      setPerf('full');
+      paint();
+    }
+  }
+
+  // Arrow keys move through a radio group, like native radio buttons.
+  function onKey(e: KeyboardEvent) {
+    if (!['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp'].includes(e.key)) return;
+    const radio = (e.target as HTMLElement | null)?.closest<HTMLElement>('[role="radio"]');
+    const group = radio?.closest('[role="radiogroup"]');
+    if (!radio || !group) return;
+    const radios = Array.from(group.querySelectorAll<HTMLButtonElement>('[role="radio"]:not(:disabled)'));
+    const i = radios.indexOf(radio as HTMLButtonElement);
+    if (i < 0) return;
+    const step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : -1;
+    const next = radios[(i + step + radios.length) % radios.length];
+    e.preventDefault();
+    next.focus();
+    next.click();
+  }
+
+  let bound = false;
+  function bind() {
+    if (bound) return;
+    bound = true;
+    // Delegated, so it survives client-side navigation re-rendering the panel.
+    document.addEventListener('click', onClick);
+    document.addEventListener('keydown', onKey);
+    window.addEventListener('appearance-change', paint);
+    window.addEventListener('perf-change', paint);
+    document.addEventListener('astro:page-load', paint);
+  }
+
+  bind();
+  paint();
+</script>
