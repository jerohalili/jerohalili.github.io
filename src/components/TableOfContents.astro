---
interface Heading {
  slug: string;
  text: string;
  depth: number;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<nav id="toc" class="hidden lg:block sticky top-32 self-start w-56 shrink-0">
  <p class="text-[10px] font-bold uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-4">
    On this page
  </p>
  <ul class="space-y-1 border-l border-zinc-200 dark:border-zinc-800">
    {filteredHeadings.map(heading => (
      <li>
        <a
          href={`#${heading.slug}`}
          class:list={[
            'toc-link block text-xs leading-relaxed transition-colors duration-200 hover:text-orange-500',
            heading.depth === 3 ? 'pl-6' : 'pl-4',
            'text-zinc-500 dark:text-zinc-400',
          ]}
          data-heading-id={heading.slug}
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  function initTOC() {
    const links = document.querySelectorAll<HTMLElement>('.toc-link');
    if (links.length === 0) return;

    const headingIds = Array.from(links).map(l => l.dataset.headingId);
    const headings = headingIds
      .map(id => document.getElementById(id!))
      .filter(Boolean) as HTMLElement[];

    if (headings.length === 0) return;

    function updateActive() {
      const scrollY = window.scrollY + 120;
      let currentId = headingIds[0];

      for (let i = 0; i < headings.length; i++) {
        if (headings[i].offsetTop <= scrollY) {
          currentId = headingIds[i];
        }
      }

      links.forEach(link => {
        const isActive = link.dataset.headingId === currentId;
        link.classList.toggle('text-orange-500', isActive);
        link.classList.toggle('font-bold', isActive);
        link.classList.toggle('text-zinc-500', !isActive);
        link.classList.toggle('dark:text-zinc-400', !isActive);
      });
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateActive();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    updateActive();
  }

  initTOC();
  document.addEventListener('astro:after-swap', initTOC);
</script>
