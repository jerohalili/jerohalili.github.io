---
const items = [ "Full-Stack Systems", "AI Orchestration", "MERN Stack", "Database Architecture", "n8n Automation", "UI/UX Design" ];
---

<section id="marquee-section" class="w-full relative overflow-hidden py-12 border-y border-zinc-100 dark:border-zinc-800 bg-white dark:bg-black transition-colors duration-500 cursor-grab active:cursor-grabbing">
    <div id="marquee-track" class="flex whitespace-nowrap select-none will-change-transform">
        {[...items, ...items].map((item) => (
        <div class="flex items-center flex-none">
            <span class="text-3xl md:text-5xl font-black tracking-tighter text-zinc-900 dark:text-white uppercase italic px-12 md:px-16">
            {item}
            </span>
            <span class="w-3 h-3 md:w-4 md:h-4 rounded-full bg-orange-500 shrink-0 shadow-[0_0_15px_rgba(249,115,22,0.4)]"></span>
        </div>
        ))}
    </div>
</section>

<script>
  function initDraggableMarquee() {
    const section = document.getElementById('marquee-section');
    const track = document.getElementById('marquee-track');
    if (!section || !track) return;

    const itemCount = 6;

    function measureSetWidth(): number {
      let total = 0;
      for (let i = 0; i < itemCount; i++) {
        const el = track.children[i] as HTMLElement;
        if (el) total += el.offsetWidth;
      }
      return total;
    }

    const setWidth = measureSetWidth();

    const naturalSpeed = -0.6;
    const friction = 0.02;
    const dragSmoothing = 0.3;

    let offset = 0;
    let velocity = naturalSpeed;
    let isDragging = false;
    let lastX = 0;
    let lastTime = 0;
    let dragVelocity = 0;
    let raf: number;

    function animate() {
      if (!isDragging) {
        velocity += (naturalSpeed - velocity) * friction;
        offset += velocity;

        if (offset < -setWidth) offset += setWidth;
        if (offset > 0) offset -= setWidth;
      }

      track.style.transform = `translateX(${offset}px)`;
      raf = requestAnimationFrame(animate);
    }

    function onPointerDown(e: PointerEvent) {
      isDragging = true;
      lastX = e.clientX;
      lastTime = performance.now();
      dragVelocity = 0;
      section.setPointerCapture(e.pointerId);
    }

    function onPointerMove(e: PointerEvent) {
      if (!isDragging) return;

      const now = performance.now();
      const dt = now - lastTime;
      const dx = e.clientX - lastX;

      if (dt > 0) {
        const rawVelocity = (dx / dt) * 16;
        dragVelocity = dragVelocity * (1 - dragSmoothing) + rawVelocity * dragSmoothing;
      }

      offset += dx;
      lastX = e.clientX;
      lastTime = now;
    }

    function onPointerUp(e: PointerEvent) {
      isDragging = false;
      velocity = dragVelocity;
      section.releasePointerCapture(e.pointerId);
    }

    section.addEventListener('pointerdown', onPointerDown);
    section.addEventListener('pointermove', onPointerMove);
    section.addEventListener('pointerup', onPointerUp);
    section.addEventListener('pointercancel', onPointerUp);

    raf = requestAnimationFrame(animate);
  }

  initDraggableMarquee();
  document.addEventListener('astro:page-load', initDraggableMarquee);
</script>
