---
const items = [ "Full-Stack Systems", "AI Orchestration", "MERN Stack", "Database Architecture", "n8n Automation", "UI/UX Design" ];
---

<style>
  @keyframes marquee-drift {
    to { transform: translateX(-50%); }
  }
  #marquee-track {
    animation: marquee-drift 32s linear infinite;
  }
  #marquee-section:hover #marquee-track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    #marquee-track { animation: none; }
  }
</style>

<section id="marquee-section" class="w-full relative overflow-hidden py-12 border-y border-zinc-100 dark:border-zinc-800 bg-white dark:bg-black transition-colors duration-500 select-none" aria-hidden="true">
    <div id="marquee-track" class="flex w-max whitespace-nowrap will-change-transform">
        {[...items, ...items].map((item) => (
        <div class="flex items-center flex-none">
            <span class="text-3xl md:text-5xl font-black tracking-tighter text-zinc-900 dark:text-white uppercase italic px-12 md:px-16">
            {item}
            </span>
            <span class="w-3 h-3 md:w-4 md:h-4 rounded-full bg-orange-500 shrink-0 shadow-[0_0_15px_rgba(249,115,22,0.4)]"></span>
        </div>
        ))}
    </div>
</section>