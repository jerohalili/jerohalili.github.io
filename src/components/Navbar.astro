---
import ThemeIcon from './ThemeIcon.astro';
import MobileMenu from './MobileMenu.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  { name: 'Projects', href: `${base}/projects` },
  { name: 'About', href: `${base}/about` },
  { name: 'Blogs', href: `${base}/blogs` },
];
---

<header class="fixed top-0 left-0 w-full pt-6 px-4 md:px-10 flex justify-center z-[9999] pointer-events-none">
  <nav class="max-w-[1400px] w-full flex justify-between items-center bg-white/70 dark:bg-zinc-900/80 backdrop-blur-xl border border-zinc-200/50 dark:border-zinc-800/50 p-2 md:p-3 rounded-2xl md:rounded-full pointer-events-auto shadow-2xl relative">
    
    <a href={`${base}/`} class="pl-4 font-black text-xl tracking-tighter dark:text-white">
      JERO<span class="text-accent-500">HALILI</span>
    </a>

    <div class="hidden lg:flex items-center gap-1">
      <a href={`${base}/`} class="px-5 py-2 rounded-full text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-accent-500 transition-colors duration-300">
        Home
      </a>
      {navLinks.map((link) => (
        <a href={link.href} class="px-5 py-2 rounded-full text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-accent-500 transition-colors duration-300">
          {link.name}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2 md:gap-3 pr-2">
      <button
        id="cp-open"
        type="button"
        data-cp-open
        aria-label="Open customize panel"
        aria-haspopup="dialog"
        title="Customize this site: themes, colors, effects"
        class="group relative w-10 h-10 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-300 hover:border-accent-500 hover:text-accent-500 hover:scale-110 active:scale-95 transition-all duration-300 pointer-events-auto"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 pointer-events-none transition-transform duration-500 group-hover:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0" />
          <circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /><circle cx="18" cy="18" r="2" />
        </svg>
        <span data-cp-ping class="absolute -top-0.5 -right-0.5 flex h-3 w-3 pointer-events-none">
          <span class="absolute inline-flex h-full w-full rounded-full bg-accent-500 opacity-75 animate-ping"></span>
          <span class="relative inline-flex h-3 w-3 rounded-full bg-accent-500"></span>
        </span>
      </button>
      <ThemeIcon />
      
      <a href={`${base}/contact`} data-magnetic="0.2" class="hidden sm:block bg-accent-500 text-white px-6 py-2.5 rounded-full text-sm font-bold hover:scale-105 transition-transform duration-300">
        Let's Talk
      </a>

      <button id="mobile-trigger" type="button" class="lg:hidden w-10 h-10 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center border border-zinc-200 dark:border-zinc-700 dark:text-white pointer-events-auto">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="pointer-events-none">
          <path d="M3 12h18M3 6h18M3 18h18"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<MobileMenu links={navLinks} />

<script>
  function setupNavbar() {
    const trigger = document.getElementById('mobile-trigger');
    if (trigger) {
      trigger.onclick = () => document.dispatchEvent(new CustomEvent('open-menu'));
    }
  }
  setupNavbar();
  document.addEventListener('astro:after-swap', setupNavbar);
</script>
