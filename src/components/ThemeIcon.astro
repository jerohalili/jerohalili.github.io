<button 
  id="theme-toggle" 
  type="button"
  aria-label="Toggle Dark Mode"
  class="group relative w-10 h-10 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center border border-zinc-200 dark:border-zinc-700 hover:border-accent-500 dark:hover:border-accent-500 hover:scale-110 active:scale-95 transition-all duration-300 overflow-hidden pointer-events-auto"
>
  <!-- MOON: Visible in Light Mode -->
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    class="w-5 h-5 block dark:hidden text-zinc-600 group-hover:text-accent-500 -rotate-12 group-hover:rotate-0 transition-all duration-500 pointer-events-none" 
    fill="none" 
    viewBox="0 0 24 24" 
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round" 
    stroke-linejoin="round"
  >
    <path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>

  <!-- SUN: Visible in Dark Mode -->
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    class="w-5 h-5 hidden dark:block text-zinc-400 group-hover:text-accent-500 rotate-0 group-hover:rotate-90 transition-all duration-500 pointer-events-none" 
    fill="none" 
    viewBox="0 0 24 24" 
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round" 
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M19.07 4.93l-1.41 1.41M6.34 17.66l-1.41 1.41" />
  </svg>

  <div class="absolute inset-0 bg-accent-500/0 dark:group-hover:bg-white/5 group-hover:bg-black/5 transition-colors duration-300"></div>
</button>

<script is:inline>
  // Light/dark is owned by the appearance runtime (see Layout.astro) so it can
  // coexist with the HUD themes; this button just flips the mode.
  function setupThemeToggle() {
    const toggleBtn = document.getElementById('theme-toggle');
    if (!toggleBtn || !window.__appearance) return;
    const newBtn = toggleBtn.cloneNode(true);
    toggleBtn.replaceWith(newBtn);
    newBtn.addEventListener('click', (e) => {
      const a = window.__appearance;
      a.setMode(a.state().mode === 'dark' ? 'light' : 'dark', { x: e.clientX, y: e.clientY });
    });
  }

  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>