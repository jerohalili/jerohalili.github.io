---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Contact from '../components/Contact.astro';
import ControlPanel from '../components/ControlPanel.astro';
import '../styles/themes.css';
import { themeDefaults, effectDefaults } from '../config/themeDefaults';
interface Props {
  title: string;
  description?: string;
  image?: string;
  publishedTime?: string;
  type?: string;
}
const { title, description = 'Portfolio of Jero Halili - Computer Scientist & Full-stack Developer', image, publishedTime, type = 'website' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://jerohalili.is-a.dev');
const ogImage = image && image.startsWith('/') ? new URL(image, canonicalURL).href : image || new URL('/og-image.png', canonicalURL).href;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <ClientRouter />
        <title>{title}</title>

        <meta name="title" content={title} />
        <meta name="description" content={description} />

        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL.href} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        {publishedTime && <meta property="article:published_time" content={publishedTime} />}

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
        <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet" /></noscript>

        <script is:inline define:vars={{ themeDefaults, effectDefaults }}>
            // Appearance runtime: theme, accent, light/dark and effect toggles.
            // Runs before first paint (no flash) and re-applies itself on every
            // client-side navigation. The Control Panel talks to window.__appearance.
            // First-visit defaults per theme live in src/config/themeDefaults.ts.
            (function () {
                if (window.__appearance) { window.__appearance.apply(); return; }

                var root = document.documentElement;
                var ACCENTS = ['orange', 'rose', 'violet', 'blue', 'cyan', 'emerald'];
                var FX = ['motion', 'particles', 'tilt', 'magnetic', 'glow', 'spotlight', 'scanlines'];
                var FONTS = 'https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&family=JetBrains+Mono:wght@400;500;700&display=swap';

                function has(obj, key) { return Object.prototype.hasOwnProperty.call(obj, key); }
                function read(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
                function write(k, v) {
                    try { if (v === null) localStorage.removeItem(k); else localStorage.setItem(k, v); } catch (e) {}
                }
                function readJson(k) {
                    try { var o = JSON.parse(read(k) || '{}'); return o && typeof o === 'object' ? o : {}; }
                    catch (e) { return {}; }
                }
                function isMode(m) { return m === 'light' || m === 'dark'; }

                // ---- Defaults (from src/config/themeDefaults.ts) ----
                function currentTheme() {
                    var t = read('ui-theme');
                    return t && has(themeDefaults, t) ? t : 'clean';
                }
                function defAccent(theme) {
                    var a = themeDefaults[theme].accent;
                    return ACCENTS.indexOf(a) >= 0 ? a : 'orange';
                }
                function defMode(theme) {
                    var m = themeDefaults[theme].mode;
                    if (isMode(m)) return m;
                    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                function fxDefault(theme, k) {
                    var over = themeDefaults[theme].effects;
                    if (over && has(over, k)) return !!over[k];
                    return !!effectDefaults[k];
                }

                // ---- Visitor choices, remembered per theme: { command: { mode, accent } } ----
                function prefs() { return readJson('ui-prefs'); }
                function setPref(theme, key, value) {
                    var p = prefs();
                    var t = p[theme] && typeof p[theme] === 'object' ? p[theme] : {};
                    if (value === null) delete t[key]; else t[key] = value;
                    if (Object.keys(t).length) p[theme] = t; else delete p[theme];
                    write('ui-prefs', Object.keys(p).length ? JSON.stringify(p) : null);
                }
                // Older versions stored one global mode ('theme') and accent ('ui-accent').
                (function migrate() {
                    var legacyMode = read('theme');
                    var legacyAccent = read('ui-accent');
                    if (legacyMode === null && legacyAccent === null) return;
                    if (isMode(legacyMode) && !(prefs().clean && prefs().clean.mode)) setPref('clean', 'mode', legacyMode);
                    if (ACCENTS.indexOf(legacyAccent) >= 0) {
                        var t = currentTheme();
                        if (!(prefs()[t] && prefs()[t].accent)) setPref(t, 'accent', legacyAccent);
                    }
                    write('theme', null);
                    write('ui-accent', null);
                })();

                function state() {
                    var theme = currentTheme();
                    var mine = prefs()[theme] || {};
                    var userAccent = ACCENTS.indexOf(mine.accent) >= 0 ? mine.accent : null;
                    var userMode = isMode(mine.mode) ? mine.mode : null;
                    var mode = userMode || defMode(theme);
                    var saved = readJson('ui-fx');
                    var fx = {};
                    FX.forEach(function (k) {
                        fx[k] = typeof saved[k] === 'boolean' ? saved[k] : fxDefault(theme, k);
                    });
                    return {
                        theme: theme,
                        accent: userAccent || defAccent(theme),
                        userAccent: userAccent,
                        mode: mode,
                        userMode: userMode,
                        dark: mode === 'dark',
                        fx: fx
                    };
                }

                function ensureFonts(doc) {
                    if (state().theme === 'clean') return;
                    if (doc.head.querySelector('link[data-ui-fonts]')) return;
                    var l = doc.createElement('link');
                    l.rel = 'stylesheet'; l.href = FONTS; l.setAttribute('data-ui-fonts', '');
                    doc.head.appendChild(l);
                }

                function apply(target) {
                    var el = target || root;
                    var s = state();
                    el.setAttribute('data-theme', s.theme);
                    el.setAttribute('data-accent', s.accent);
                    el.classList.toggle('dark', s.dark);
                    FX.forEach(function (k) { el.setAttribute('data-fx-' + k, s.fx[k] ? 'on' : 'off'); });
                    if (!target) ensureFonts(document); // HUD fonts load only when a HUD theme is picked
                    return s;
                }

                // How a change is presented:
                //  - Control Panel open (where people click through options quickly): the page
                //    switches instantly and a soft ripple spreads from the click. A view
                //    transition would cover the page and swallow the next clicks, and
                //    restarting it on every click re-shows the previous look (flicker).
                //  - Panel closed (e.g. the sun/moon button): a circular reveal where supported.
                // CSS transitions are frozen while the look changes (data-vt) so colors
                // switch cleanly instead of fading in from the old values.
                var seq = 0;
                var active = null;

                function ripple(origin) {
                    var host = document.body;
                    if (!host) return;
                    var old = host.querySelectorAll('.fx-ripple');
                    for (var i = 0; i <= old.length - 4; i++) old[i].remove(); // keep at most 4
                    var r = document.createElement('div');
                    r.className = 'fx-ripple';
                    r.setAttribute('aria-hidden', 'true');
                    r.style.left = origin.x + 'px';
                    r.style.top = origin.y + 'px';
                    r.addEventListener('animationend', function () { r.remove(); });
                    setTimeout(function () { r.remove(); }, 900); // fallback if animationend never fires
                    host.appendChild(r);
                }

                function commit(origin) {
                    var run = function () {
                        var s = apply();
                        window.dispatchEvent(new CustomEvent('appearance-change', { detail: s }));
                    };
                    if (active) { run(); return; }

                    var motion = state().fx.motion;
                    var panel = document.getElementById('control-panel');
                    var panelOpen = !!(panel && panel.open);
                    var mine = ++seq;
                    var settle = function () {
                        if (mine !== seq) return;
                        root.removeAttribute('data-vt');
                        active = null;
                    };

                    if (document.startViewTransition && motion && origin && !panelOpen) {
                        var quiet = function () {}; // a skipped transition is normal, not an error
                        root.style.setProperty('--vt-x', origin.x + 'px');
                        root.style.setProperty('--vt-y', origin.y + 'px');
                        root.setAttribute('data-vt', 'reveal');
                        var t = document.startViewTransition(run);
                        active = t;
                        t.ready.catch(quiet);
                        t.updateCallbackDone.catch(quiet);
                        t.finished.then(settle, settle);
                        // Safety net: never leave the page covered by a stuck transition.
                        setTimeout(function () {
                            if (mine !== seq) return;
                            try { t.skipTransition(); } catch (e) {}
                            settle();
                        }, 1200);
                    } else {
                        root.setAttribute('data-vt', 'instant');
                        run();
                        if (motion && origin) ripple(origin);
                        requestAnimationFrame(function () { requestAnimationFrame(settle); });
                    }
                }

                window.__appearance = {
                    themes: Object.keys(themeDefaults), accents: ACCENTS, effects: FX,
                    state: state, apply: apply,
                    setTheme: function (t, origin) { if (has(themeDefaults, t)) { write('ui-theme', t); commit(origin); } },
                    setAccent: function (a, origin) {
                        setPref(currentTheme(), 'accent', ACCENTS.indexOf(a) < 0 ? null : a);
                        commit(origin);
                    },
                    setMode: function (m, origin) {
                        setPref(currentTheme(), 'mode', isMode(m) ? m : null);
                        commit(origin);
                    },
                    setFx: function (k, on) {
                        if (FX.indexOf(k) < 0) return;
                        // Only remember choices that differ from the theme's default, so switching
                        // themes keeps picking up each theme's own defaults.
                        var f = readJson('ui-fx');
                        if (!!on === fxDefault(currentTheme(), k)) delete f[k]; else f[k] = !!on;
                        write('ui-fx', Object.keys(f).length ? JSON.stringify(f) : null);
                        commit();
                    },
                    reset: function (origin) {
                        write('ui-theme', null); write('ui-prefs', null); write('ui-fx', null);
                        commit(origin);
                    }
                };

                apply();

                // Client-side navigation swaps <html>'s attributes; re-apply to the incoming
                // document so nothing flashes, and carry the Lite/Full choice across.
                document.addEventListener('astro:before-swap', function (e) {
                    var next = e.newDocument.documentElement;
                    apply(next);
                    ensureFonts(e.newDocument);
                    var perf = root.getAttribute('data-perf');
                    if (perf) next.setAttribute('data-perf', perf);
                });
            })();
        </script>

        <script is:inline>
            // Decide Lite vs Full before first paint. Stored choice wins, else auto-detect weak device.
            try {
                const stored = localStorage.getItem('perf-mode');
                let mode = 'full';
                if (stored === 'full' || stored === 'lite') {
                    mode = stored;
                } else {
                    const conn = navigator.connection;
                    const saveData = conn && conn.saveData;
                    const eff = conn && conn.effectiveType;
                    const slowNet = eff === 'slow-2g' || eff === '2g' || eff === '3g';
                    const weakCPU = typeof navigator.hardwareConcurrency === 'number' && navigator.hardwareConcurrency <= 4;
                    const weakRAM = typeof navigator.deviceMemory === 'number' && navigator.deviceMemory <= 4;
                    if (saveData || slowNet || weakCPU || weakRAM) mode = 'lite';
                }
                document.documentElement.dataset.perf = mode;
            } catch { document.documentElement.dataset.perf = 'full'; }
        </script>

        <style is:global>
            /* Lite: hide heavy canvases/blob, keep layout identical */
            html[data-perf='lite'] #hero-constellation,
            html[data-perf='lite'] #skillsCanvas,
            html[data-perf='lite'] #cursor-blob {
                display: none;
            }
            /* Lite-only: profile card behaves like main card — no parallax transition lag */
            html[data-perf='lite'] .parallax-layer {
                transform: none !important;
                transition: none !important;
            }
            .animate-in {
                animation: fadeIn 0.8s ease-out forwards;
            }

            @keyframes fadeIn {
                from { opacity: 0; transform: translateY(10px); }
                to { opacity: 1; transform: translateY(0); }
            }

            [data-reveal] {
                opacity: 0;
                transform: translateY(20px);
                transition: opacity 0.6s ease-out, transform 0.6s ease-out;
            }

            [data-reveal].revealed {
                opacity: 1;
                transform: translateY(0);
            }

        </style>
    </head>
    <body class="bg-[#FDFDFD] dark:bg-[#121212] text-zinc-900 dark:text-zinc-100 transition-colors duration-500 antialiased selection:bg-accent-500/30 overflow-x-hidden">
        
        <div 
            id="cursor-blob" 
            class="fixed top-0 left-0 w-[300px] h-[300px] sm:w-[600px] sm:h-[600px] bg-accent-500/20 dark:bg-accent-600/25 rounded-full blur-[80px] sm:blur-[140px] pointer-events-none transition-opacity duration-1000 opacity-0 z-[1]"
            style="will-change: transform;"
        ></div>
        
        <div id="fx-grid" aria-hidden="true"></div>
        <div id="fx-scan" aria-hidden="true"></div>

        <Navbar />
        
        <main id="main-content" class="relative z-[2] animate-in">
            <slot />
        </main>

        <Contact />
        <ControlPanel />

        <script>
            import { initMagneticElements } from '../scripts/magnetic';
            import { initTiltElements } from '../scripts/tilt';
            import { initScrollReveal } from '../scripts/scroll-reveal';

            let blob: HTMLElement | null = null;
            let grid: HTMLElement | null = null;
            let curX = 0, curY = 0, tgX = 0, tgY = 0;
            let animationFrameId: number;
            let isVisible = true;

            const isTouchDevice = window.matchMedia("(pointer: coarse)").matches;

            function initBlob() {
                // Lite kill-switch: no blob loop at all (CSS hides it). Full path below untouched.
                if (document.documentElement.dataset.perf === 'lite') return;
                blob = document.getElementById('cursor-blob');
                grid = document.getElementById('fx-grid');
                if (isTouchDevice) {
                    if (blob) {
                        blob.style.opacity = "0.6";
                        blob.style.transform = `translate3d(calc(70vw - 150px), calc(20vh - 150px), 0)`;
                    }
                    return;
                }
                window.addEventListener('mousemove', (e) => {
                    tgX = e.clientX;
                    tgY = e.clientY;
                    if (blob) blob.style.opacity = "1";
                });
                render();
            }

            function render() {
                if (document.documentElement.dataset.perf === 'lite') return;
                if (!isVisible) {
                    animationFrameId = requestAnimationFrame(render);
                    return;
                }
                curX += (tgX - curX) * 0.03;
                curY += (tgY - curY) * 0.03;
                if (blob) {
                    const offset = window.innerWidth < 640 ? 150 : 300;
                    blob.style.transform = `translate3d(${curX - offset}px, ${curY - offset}px, 0)`;
                }
                if (grid && document.documentElement.dataset.theme === 'command' && document.documentElement.dataset.fxGlow !== 'off') {
                    grid.style.setProperty('--mx', `${curX}px`);
                    grid.style.setProperty('--my', `${curY}px`);
                }
                animationFrameId = requestAnimationFrame(render);
            }

            // Card spotlight: tell the hovered card where the pointer is (CSS draws the glow).
            const SPOT = '.glass-card, .project-card, .testimonial-card, [data-tilt]';
            let spotFrame = 0;
            document.addEventListener('pointermove', (e) => {
                if (document.documentElement.dataset.fxSpotlight !== 'on' || document.documentElement.dataset.perf === 'lite' || e.pointerType === 'touch') return;
                const card = (e.target as Element | null)?.closest?.(SPOT) as HTMLElement | null;
                if (!card) return;
                cancelAnimationFrame(spotFrame);
                spotFrame = requestAnimationFrame(() => {
                    const r = card.getBoundingClientRect();
                    card.style.setProperty('--sx', `${e.clientX - r.left}px`);
                    card.style.setProperty('--sy', `${e.clientY - r.top}px`);
                });
            }, { passive: true });

            function handleAnchorAnimation() {
                const main = document.getElementById('main-content');
                const links = document.querySelectorAll('a[href*="#"]');
                links.forEach(link => {
                    link.addEventListener('click', () => {
                        if (main) {
                            main.classList.remove('animate-in');
                            void main.offsetWidth;
                            main.classList.add('animate-in');
                        }
                    });
                });
            }

            function initAll() {
                initBlob();
                handleAnchorAnimation();
                initMagneticElements();
                initTiltElements();
                initScrollReveal();
            }

            document.addEventListener('visibilitychange', () => {
                isVisible = !document.hidden;
            });

            initAll();
            document.addEventListener('astro:after-swap', () => {
                cancelAnimationFrame(animationFrameId);
                initAll();
            });
            window.addEventListener('perf-change', (e) => {
                if ((e as CustomEvent).detail === 'full') {
                    cancelAnimationFrame(animationFrameId);
                    initBlob();
                } else {
                    cancelAnimationFrame(animationFrameId);
                }
            });
        </script>
    </body>
</html>
